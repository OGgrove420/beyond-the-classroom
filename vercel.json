{
  "version": 2,
  "name": "beyond-the-classroom",
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python", "config": { "includeFiles": "../data/site.json" } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/style.css", "dest": "/public/style.css" },
    { "src": "/app.js", "dest": "/public/app.js" },
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
